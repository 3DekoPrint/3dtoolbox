# 3dtoolbox.info - Caddy-Konfiguration (Quelle der Wahrheit; auf dem Server nach /etc/caddy/Caddyfile kopieren)
# Bewusst ohne Snippet-Argumente (Platzhalter-Verhalten unterscheidet sich je nach Caddy-Version).
# Nur der Konverter braucht 'unsafe-eval' (STEP-Modul).
(sec) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}

3dtoolbox.info {
    root * /var/www/3dtoolbox
    encode zstd gzip
    # WASM-Module zusätzlich komprimieren (Standardliste enthält application/wasm nicht)
    encode {
        zstd
        gzip
        match {
            header Content-Type application/wasm*
        }
    }

    # Versionsverwaltung und Server-Dateien nie ausliefern
    @hidden path /.git /.git/* /deploy /deploy/* /server /server/* /.github/* /.gitignore
    handle @hidden {
        respond 404
    }

    @convert path /3d-datei-konverter.html /en/3d-file-converter.html /3d-datei-konverter /en/3d-file-converter
    handle @convert {
        import sec
        header Content-Security-Policy "default-src 'self'; script-src 'self' https://gc.zgo.at 'unsafe-inline' 'wasm-unsafe-eval' blob: 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https://3dtoolbox.goatcounter.com data: blob:; font-src 'self' data:; connect-src 'self' https://3dtoolbox.goatcounter.com https://api.web3forms.com blob: data:; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        header Cache-Control "no-cache"
        try_files {path} {path}.html
        file_server
    }

    handle {
        import sec
        header Content-Security-Policy "default-src 'self'; script-src 'self' https://gc.zgo.at 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' https://3dtoolbox.goatcounter.com data: blob:; font-src 'self' data:; connect-src 'self' https://3dtoolbox.goatcounter.com https://api.web3forms.com blob: data:; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        try_files {path} {path}.html {path}/index.html

        # Cache: Code (JS/CSS) und HTML werden bei jedem Aufruf per ETag geprüft (304 = fast kostenlos),
        # damit Änderungen sofort ankommen. Schwere, selten geänderte Dateien (Bilder, Schriften, WASM) 1 Tag.
        @code path *.html *.js *.css /
        header @code Cache-Control "no-cache"
        @heavy path *.webp *.png *.jpg *.svg *.woff2 *.wasm *.ico
        header @heavy Cache-Control "public, max-age=86400"
        file_server
    }
}

www.3dtoolbox.info {
    redir https://3dtoolbox.info{uri} permanent
}
